{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromatic-atomic-tower.dev/schemas/authority_matrix.schema.json",
  "title": "CAT Canonical Authority Matrix",
  "description": "Machine-readable declaration of one canonical writer for each mutable governance fact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "canonical_writer_rule",
    "entries"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "canonical_writer_rule": {
      "const": "exactly_one_writer"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authority_entry"
      }
    }
  },
  "$defs": {
    "authority_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "canonical_owner",
        "canonical_path",
        "write_policy",
        "consumers"
      ],
      "properties": {
        "fact": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "canonical_owner": {
          "type": "string",
          "enum": [
            "CAT",
            "Harness V2",
            "Project Repository"
          ]
        },
        "canonical_path": {
          "type": "string",
          "minLength": 1
        },
        "write_policy": {
          "type": "string",
          "enum": [
            "CAT_ONLY",
            "LOCAL_ONLY",
            "RUNTIME_EVIDENCE_ONLY",
            "DERIVED_READ_ONLY"
          ]
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "examples": [
    {
      "version": "1.0.0",
      "canonical_writer_rule": "exactly_one_writer",
      "entries": [
        {
          "fact": "global_mission_selection",
          "canonical_owner": "CAT",
          "canonical_path": "missions/registry/MISSION_REGISTRY.yaml",
          "write_policy": "CAT_ONLY",
          "consumers": [
            "Harness V2",
            "ANNA",
            "future governed repositories"
          ]
        },
        {
          "fact": "bead_lifecycle",
          "canonical_owner": "CAT",
          "canonical_path": "scripts/cat_transition.py",
          "write_policy": "CAT_ONLY",
          "consumers": [
            "Harness V2",
            "ANNA",
            "future governed repositories"
          ]
        },
        {
          "fact": "cross_repo_evidence_requirements",
          "canonical_owner": "CAT",
          "canonical_path": "evidence/ and gates/",
          "write_policy": "CAT_ONLY",
          "consumers": [
            "Harness V2",
            "ANNA",
            "future governed repositories"
          ]
        },
        {
          "fact": "runtime_execution_evidence",
          "canonical_owner": "Harness V2",
          "canonical_path": "external:harness-v2/evidence",
          "write_policy": "RUNTIME_EVIDENCE_ONLY",
          "consumers": [
            "CAT"
          ]
        },
        {
          "fact": "project_tree_rules",
          "canonical_owner": "Project Repository",
          "canonical_path": "CHROMATIC_TREES.md",
          "write_policy": "LOCAL_ONLY",
          "consumers": [
            "project-local agents and tools",
            "CAT adapter"
          ]
        },
        {
          "fact": "project_execution_snapshot",
          "canonical_owner": "Project Repository",
          "canonical_path": ".cat/state.json",
          "write_policy": "LOCAL_ONLY",
          "consumers": [
            "CAT adapter"
          ]
        },
        {
          "fact": "cat_derived_state",
          "canonical_owner": "CAT",
          "canonical_path": "state/SPRINT_STATE.md and state/AGENT_HANDOFF_QUEUE.md",
          "write_policy": "DERIVED_READ_ONLY",
          "consumers": [
            "operators",
            "agents",
            "CAT adapters"
          ]
        }
      ]
    }
  ]
}
