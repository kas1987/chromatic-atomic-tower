{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromatic-atomic-tower.dev/schemas/cross_repo_mutation.schema.json",
  "title": "CAT Cross-Repository Mutation Request",
  "description": "Complete trace required before a bounded external repository mutation can be authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mission_id",
    "bead_id",
    "target_repo",
    "operation",
    "target_paths",
    "allowed_paths",
    "validation_command",
    "evidence_path",
    "rollback_reference",
    "approved_by",
    "requested_at"
  ],
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\r\\n]+$"
    },
    "path_pattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\r\\n]+$"
    }
  },
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MP-CAT-[A-Z0-9]+-[0-9A-Z]+$"
    },
    "bead_id": {
      "type": "string",
      "pattern": "^BEAD-CAT-[A-Z0-9]+-[0-9A-Z]+-[0-9]{2}$"
    },
    "target_repo": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "operation": {
      "type": "string",
      "enum": ["create", "write", "delete"]
    },
    "target_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path_pattern" }
    },
    "validation_command": {
      "type": "string",
      "minLength": 1
    },
    "evidence_path": {
      "allOf": [
        { "$ref": "#/$defs/relative_path" },
        { "type": "string", "pattern": "^evidence/" }
      ]
    },
    "rollback_reference": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
